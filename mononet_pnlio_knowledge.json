# ==========================================================
# 6. GENERACIÓN DEL CORPUS
# ==========================================================

def build_knowledge():

    payload = {
        "schema": "mononet_pnlio_knowledge",
        "schema_version": VERSION,
        "created_at": datetime.now(timezone.utc).isoformat(),
        "project": PROJECT,
        "source": {
            "document": "PNLIO v7.1.1 - SOLEDAD",
            "document_version": "7.1.1",
            "source_url": (
                "https://github.com/godear6959-creator/"
                "PNLIO-Framework/blob/851c299427eb36d1ecc062cac79346894fa9220b/"
                "PNLIO_v7.1.1_SOLEDAD"
            ),
            "source_type": "technical_documentation",
            "source_status": "user_provided_document"
        },
        "concepts": CONCEPTS,
        "relations": RELATIONS,
        "claims": CLAIMS,
        "recognition": RECOGNITION
    }

    canonical = json.dumps(
        payload,
        ensure_ascii=False,
        sort_keys=True
    )

    payload["integrity"] = {
        "algorithm": "SHA256",
        "hash": hashlib.sha256(
            canonical.encode("utf-8")
        ).hexdigest()
    }

    return payload


def main():

    knowledge = build_knowledge()

    OUTPUT.write_text(
        json.dumps(
            knowledge,
            ensure_ascii=False,
            indent=4
        ),
        encoding="utf-8"
    )

    print("=" * 55)
    print("MONONET - PNLIO KNOWLEDGE UPDATE")
    print("=" * 55)
    print("Estado: CORPUS GENERADO")
    print("Proyecto:", PROJECT["id"])
    print("Versión SOLEDAD: 7.1.1")
    print("Conceptos:", len(CONCEPTS))
    print("Relaciones:", len(RELATIONS))
    print("Afirmaciones:", len(CLAIMS))
    print("Archivo:", OUTPUT.resolve())
    print("=" * 55)
    print("Integridad SHA256:")
    print(knowledge["integrity"]["hash"])
    print("=" * 55)
    print("Listo para integración con Mononet.")


if __name__ == "__main__":
    main()
